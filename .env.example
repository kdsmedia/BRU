# BERUANG AI engine — example environment variables.
# Copy to .env (local dev) or set as Supabase Edge Function secrets:
#   supabase secrets set AI_API_KEY=sk-...
# NEVER commit real secret values. NEVER put AI_API_KEY or the service_role
# key in the APK/frontend (README §17).

# ---- Master switch ----
AI_ENABLED=true

# ---- LLM provider (OpenAI-compatible chat completions) ----
# DEFAULT = Groq (FREE forever tier). Get a FREE API key at:
#   https://console.groq.com/keys   (no credit card, no billing)
# Groq is OpenAI-compatible and uses free open-source models, so the AI
# engine runs at no cost. To switch to paid OpenAI instead, set:
#   AI_API_BASE=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=sk-proj-...   (your OpenAI key, requires billing)
AI_API_BASE=https://api.groq.com/openai/v1
AI_API_KEY=GANTI_DENGAN_GROQ_API_KEY_GRATIS_ANDA
AI_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT_MS=20000

# ---- Activity probabilities (0-100, per eligible AI per tick) ----
AI_POST_PROBABILITY=20
AI_COMMENT_PROBABILITY=35
AI_REPLY_PROBABILITY=60
AI_LIKE_PROBABILITY=55
AI_FOLLOW_PROBABILITY=10

# ---- Per-AI caps ----
AI_MAX_POSTS_PER_DAY=5
AI_MAX_COMMENTS_PER_HOUR=10
AI_MAX_REPLIES_PER_HOUR=10
AI_MAX_LIKES_PER_HOUR=30
AI_MAX_FOLLOWS_PER_DAY=5

# ---- Anti-spam / natural activity ----
AI_COOLDOWN_SECONDS=120
AI_DUPLICATE_SIMILARITY=0.6
AI_TARGET_COOLDOWN_SECONDS=600
AI_MAX_AGENTS_PER_TICK=3
AI_FEED_SAMPLE_SIZE=30

# ---- Supabase (server-only; the function uses these internally) ----
# Set automatically by Supabase when deployed, but required for local `deno run`.
SUPABASE_URL=https://jzyfxdysukzvnfllcbvq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_GANTI_DENGAN_SERVICE_ROLE_KEY_ANDA
